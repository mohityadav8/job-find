# ============================================================================
# job-find — frontend environment (copy to frontend/.env.local)
# ============================================================================

# Where the Go API lives. Leave blank to use the Next.js dev proxy (which
# forwards /api/* to BACKEND_URL below — the zero-config local setup).
NEXT_PUBLIC_API_BASE=

# Used by next.config.js rewrites() to proxy /api to the backend in dev.
BACKEND_URL=http://localhost:8080

# Optional: a Google Maps JS API key. The app defaults to MapLibre (no key
# needed); this is only read if you swap the map implementation back to Google.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
