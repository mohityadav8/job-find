# ============================================================================
# job-find — backend environment (copy to backend/.env for local dev)
# ============================================================================

# --- Core infrastructure (required) -----------------------------------------
# Postgres+PostGIS connection string. Matches docker-compose credentials.
DATABASE_URL=postgres://jobfind:localdevpassword@localhost:5432/jobfind?sslmode=disable
# Redis for the Asynq background queue.
REDIS_ADDR=127.0.0.1:6379
# Port the API server listens on.
PORT=8080

# --- Auth (dashboard) -------------------------------------------------------
# Secret used to sign JWTs. CHANGE THIS in any non-local environment.
JWT_SECRET=dev-insecure-change-me
# Token lifetime (Go duration string).
JWT_TTL=24h

# --- API behavior -----------------------------------------------------------
# Comma-separated list of allowed CORS origins (the frontend).
ALLOW_ORIGINS=http://localhost:3000
# Response cache TTL for /pins etc. (Go duration string).
CACHE_TTL=60s
# Per-IP rate limit: sustained requests/sec and burst allowance.
RATE_RPS=20
RATE_BURST=40

# --- Ingestion --------------------------------------------------------------
# Cron spec for the scheduled sync (default: every 6 hours).
INGEST_CRON=0 */6 * * *
# Max results pulled per source per query each pass (keeps free tiers happy).
INGEST_PER_QUERY=100

# --- Data-source credentials (all OPTIONAL) ---------------------------------
# RemoteOK + Remotive need no keys and are always enabled.
# Adzuna: https://developer.adzuna.com/ (free tier). Both required to enable.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about (free tier).
JOOBLE_API_KEY=

# --- Geocoding (OPTIONAL) ---------------------------------------------------
# Google Geocoding/Maps key. If unset, geocoding falls back to free Nominatim.
# NOTE (README §6): set a Google Cloud budget alert BEFORE using this key.
GOOGLE_MAPS_API_KEY=
