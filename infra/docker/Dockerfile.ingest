# ---- build stage ----------------------------------------------------------
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./backend/
WORKDIR /src/backend
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/ingest ./cmd/ingest

# ---- runtime stage --------------------------------------------------------
FROM alpine:3.20
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 app
WORKDIR /app
COPY --from=build /out/ingest ./ingest
USER app
# Default mode is "worker" (queue processor + cron scheduler). Override the
# command to run "once" (one-shot seed) or "scheduler" only.
ENTRYPOINT ["./ingest"]
CMD ["worker"]
